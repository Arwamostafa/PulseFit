<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <!-- ^ Tailwind CSS file -->
    <link rel="stylesheet" href="~/css/style.css" />
    <title>Power fitness | @ViewData["Title"]</title>
</head>
<body class="bg-background text-slate-200 antialiased font-sans min-h-screen flex flex-col selection:bg-primary/30 selection:text-primary-light">
    <partial name="_Nav" />

    <main role="main" class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
