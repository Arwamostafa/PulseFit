@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden rounded-3xl mt-4">
    <div class="absolute inset-0 bg-gradient-to-br from-surface to-background z-0"></div>
    <div class="absolute inset-0 bg-[url('/images/Theo Vance.jpg')] bg-cover bg-center opacity-20 mix-blend-overlay z-0"></div>
    
    <div class="container mx-auto px-4 relative z-10 text-center">
        <h1 class="text-5xl md:text-7xl font-bold mb-6 text-textMain tracking-tight opacity-0 animate-fade-in-up delay-100">
            Your body can <br/>
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-light to-primary">stand almost anything</span>
        </h1>
        <p class="text-lg md:text-xl text-textMuted max-w-2xl mx-auto mb-10 leading-relaxed opacity-0 animate-fade-in-up delay-200">
            It's your mind that needs convincing. Push past your limits, stay committed, and watch as your body transforms into a powerhouse of strength and resilience.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 opacity-0 animate-fade-in-up delay-300">
            <button class="btn-primary text-lg w-full sm:w-auto">Get Started Now</button>
            <button class="btn-secondary text-lg w-full sm:w-auto bg-transparent border border-slate-600 hover:bg-slate-800">Explore Programs</button>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="py-16 -mt-12 relative z-20 opacity-0 animate-fade-in-up delay-500">
    <div class="container mx-auto px-4">
        <div class="glass-card grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-slate-700/50">
            <div class="space-y-2">
                <div class="text-4xl font-bold text-primary-light">100+</div>
                <div class="text-sm text-textMuted font-medium uppercase tracking-wider">Total Members</div>
            </div>
            <div class="space-y-2">
                <div class="text-4xl font-bold text-primary-light">20+</div>
                <div class="text-sm text-textMuted font-medium uppercase tracking-wider">Expert Trainers</div>
            </div>
            <div class="space-y-2">
                <div class="text-4xl font-bold text-primary-light">50+</div>
                <div class="text-sm text-textMuted font-medium uppercase tracking-wider">Weekly Classes</div>
            </div>
            <div class="space-y-2">
                <div class="text-4xl font-bold text-primary-light">24/7</div>
                <div class="text-sm text-textMuted font-medium uppercase tracking-wider">Gym Access</div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-20">
    <div class="container mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-16 items-center">
            <div class="w-full lg:w-1/2 opacity-0 animate-fade-in-up">
                <div class="relative rounded-2xl overflow-hidden aspect-[4/3] shadow-2xl">
                    <img src="https://images.unsplash.com/photo-1581009146145-b5ef050c2e1e?q=80&w=2070&auto=format&fit=crop" alt="About us" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent"></div>
                </div>
            </div>
            
            <div class="w-full lg:w-1/2 space-y-8 opacity-0 animate-fade-in-up delay-200">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary-light text-sm font-semibold">
                    <i class="bi bi-star-fill"></i> About Us
                </div>
                
                <h2 class="text-4xl md:text-5xl font-bold text-textMain leading-tight">
                    Empowering you to achieve <span class="text-primary-light">your fitness goals</span>
                </h2>
                
                <p class="text-textMuted text-lg leading-relaxed">
                    We believe fitness is more than just a workout—it's a lifestyle. With top-of-the-line facilities, certified trainers, and a supportive community, we're here to inspire and guide you every step of the way.
                </p>
                
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4">
                    <div class="glass-card flex items-start gap-4">
                        <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center flex-shrink-0">
                            <i class="bi bi-person-badge text-xl text-primary-light"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-textMain mb-1">Personal Training</h3>
                            <p class="text-sm text-textMuted">Guidance from certified experts</p>
                        </div>
                    </div>
                    <div class="glass-card flex items-start gap-4">
                        <div class="w-12 h-12 rounded-lg bg-primary/20 flex items-center justify-center flex-shrink-0">
                            <i class="bi bi-heart-pulse text-xl text-primary-light"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-textMain mb-1">Health Analytics</h3>
                            <p class="text-sm text-textMuted">Track your progress easily</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Workouts Section -->
<section class="py-20 bg-surface/30">
    <div class="container mx-auto px-4">
        <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
            <h2 class="text-sm font-bold text-primary-light uppercase tracking-widest">Workouts</h2>
            <h3 class="text-3xl md:text-4xl font-bold text-textMain">Transform Your Body with Dynamic Sessions</h3>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Card 1 -->
            <div class="group card p-0 overflow-hidden opacity-0 animate-fade-in-up delay-100">
                <div class="relative h-64 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&w=2070&auto=format&fit=crop" alt="Workout" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent"></div>
                </div>
                <div class="p-6">
                    <h4 class="text-xl font-bold text-textMain mb-2">High Intensity Interval</h4>
                    <p class="text-textMuted text-sm mb-4">Burn calories fast with our HIIT sessions designed for maximum results.</p>
                    <a href="#" class="text-primary-light font-medium hover:text-primary transition-colors flex items-center gap-2">
                        Explore <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Card 2 -->
            <div class="group card p-0 overflow-hidden opacity-0 animate-fade-in-up delay-300">
                <div class="relative h-64 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=2070&auto=format&fit=crop" alt="Workout" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent"></div>
                </div>
                <div class="p-6">
                    <h4 class="text-xl font-bold text-textMain mb-2">Strength & Conditioning</h4>
                    <p class="text-textMuted text-sm mb-4">Build muscle and increase your power with guided heavy lifting.</p>
                    <a href="#" class="text-primary-light font-medium hover:text-primary transition-colors flex items-center gap-2">
                        Explore <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            
            <!-- Card 3 -->
            <div class="group card p-0 overflow-hidden opacity-0 animate-fade-in-up delay-500">
                <div class="relative h-64 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1583454110551-21f2fa2afe61?q=80&w=2070&auto=format&fit=crop" alt="Workout" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-surface to-transparent"></div>
                </div>
                <div class="p-6">
                    <h4 class="text-xl font-bold text-textMain mb-2">Yoga & Flexibility</h4>
                    <p class="text-textMuted text-sm mb-4">Improve your mobility and core strength in our relaxing yoga classes.</p>
                    <a href="#" class="text-primary-light font-medium hover:text-primary transition-colors flex items-center gap-2">
                        Explore <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
