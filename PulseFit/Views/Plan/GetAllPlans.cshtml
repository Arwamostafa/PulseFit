@model IEnumerable<PulseFit.BLL.ModelViews.PlanModelView>

@{
    ViewData["Title"] = "Plans";
}

<div class="space-y-12 py-10 opacity-0 animate-fade-in-up delay-100">
    <div class="text-center space-y-3">
        <h1 class="text-4xl md:text-5xl font-extrabold text-white tracking-tight">Select Your Protocol</h1>
        <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">Optimize your physical parameters with our structured performance tiers.</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center max-w-6xl mx-auto px-4 relative">
            @{ int index = 0; }
            @foreach (var plan in Model)
            {
                bool isMiddle = index == 1; // Highlight the second card
                var delayMs = index * 100 + 200;
                index++;
                
                <div class="relative bg-[#111] rounded-2xl flex flex-col h-full opacity-0 animate-fade-in-up transition-transform duration-300 hover:-translate-y-2 @(isMiddle ? "border-2 border-[#C6FF00] shadow-[0_0_40px_rgba(198,255,0,0.15)] z-10 scale-105" : "border border-slate-800")" style="animation-delay: @(delayMs)ms">
                    
                    @if (isMiddle)
                    {
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[#C6FF00] text-black text-[10px] font-extrabold px-3 py-1 rounded-full tracking-widest uppercase">
                            Recommended
                        </div>
                    }

                    <div class="p-8 flex flex-col flex-grow text-center">
                        <h3 class="text-2xl font-bold text-white mb-2">@plan.Name</h3>
                        
                        <div class="mb-8">
                            <span class="text-5xl font-black @(isMiddle ? "text-[#C6FF00]" : "text-white")">@plan.Price</span>
                            <span class="text-slate-400 text-xs font-bold uppercase tracking-wider ml-1">EGP</span>
                        </div>

                        <div class="space-y-6 text-left flex-grow mb-8">
                            <div class="flex items-start gap-4">
                                <i class="bi bi-calendar-event text-xl @(isMiddle ? "text-[#C6FF00]" : "text-slate-400") mt-0.5"></i>
                                <div>
                                    <div class="text-[10px] font-bold text-slate-500 tracking-widest uppercase">Duration</div>
                                    <div class="text-sm font-bold text-white">@plan.DurationDays Days</div>
                                </div>
                            </div>
                            
                            <div class="flex items-start gap-4">
                                <i class="bi bi-file-text text-xl @(isMiddle ? "text-[#C6FF00]" : "text-slate-400") mt-0.5"></i>
                                <div>
                                    <div class="text-[10px] font-bold text-slate-500 tracking-widest uppercase">Description</div>
                                    <div class="text-sm font-bold text-white leading-relaxed">@plan.Description</div>
                                </div>
                            </div>

                            @if (isMiddle)
                            {
                                <div class="flex items-start gap-4">
                                    <i class="bi bi-star-fill text-xl text-[#C6FF00] mt-0.5"></i>
                                    <div>
                                        <div class="text-[10px] font-bold text-slate-500 tracking-widest uppercase">Perks</div>
                                        <div class="text-sm font-bold text-white leading-relaxed">Includes full facility access.</div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="space-y-3 mt-auto">
                            <a asp-controller="Plan" asp-action="GetPlan" asp-route-id="@plan.Id" class="block w-full py-3 rounded-lg font-bold transition-colors @(isMiddle ? "bg-[#C6FF00] text-black hover:bg-[#b0e600]" : "bg-[#C6FF00] text-black hover:bg-[#b0e600]") text-sm flex items-center justify-center gap-2">
                                <i class="bi bi-eye"></i> View Details
                            </a>
                            
                            <div class="grid grid-cols-2 gap-3">
                                <a asp-controller="Plan" asp-action="GetPlanToUpdate" asp-route-id="@plan.Id" class="py-2.5 rounded-lg bg-[#1a1a1a] border border-slate-800 hover:bg-slate-800 transition-colors text-white text-xs font-bold flex items-center justify-center gap-2">
                                    <i class="bi bi-pencil-fill text-slate-400"></i> Edit
                                </a>
                                <form asp-controller="Plan" asp-action="ToggleActive" asp-route-id="@plan.Id" method="post" class="w-full">
                                    <button type="submit" class="w-full py-2.5 rounded-lg bg-[#1a1a1a] border border-slate-800 hover:bg-slate-800 transition-colors text-white text-xs font-bold flex items-center justify-center gap-2">
                                        @if (plan.IsActive)
                                        {
                                            <i class="bi bi-x-circle-fill text-red-500"></i> <span>Deactivate</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-circle-fill text-green-500"></i> <span>Activate</span>
                                        }
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="glass-card flex flex-col items-center justify-center py-20 text-center border-dashed border-2 border-slate-600 mt-8 max-w-3xl mx-auto">
            <div class="w-20 h-20 rounded-full bg-surfaceHover flex items-center justify-center mb-6">
                <i class="bi bi-inbox text-4xl text-slate-400"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">No Protocols Available</h3>
            <p class="text-slate-400 max-w-md mx-auto">You haven't created any membership plans yet. Create your first plan to start offering memberships.</p>
        </div>
    }
</div>
