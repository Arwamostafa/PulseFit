@using PulseFit.BLL.ModelViews
@model PlanModelView

@{
    ViewData["Title"] = "Plan Details";
}

<div class="container mx-auto px-4 py-8 opacity-0 animate-fade-in-up delay-100">
    <div class="max-w-2xl mx-auto">
        <div class="glass-card p-0 overflow-hidden relative">
            
            <!-- Header -->
            <div class="py-10 text-center relative @(Model.IsActive ? "bg-gradient-to-br from-primary-light to-primary" : "bg-slate-700")">
                <div class="absolute inset-0 bg-[url('/images/pattern.svg')] opacity-10"></div>
                <div class="relative z-10 flex flex-col items-center">
                    <div class="w-20 h-20 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center mb-4 shadow-lg border border-white/30">
                        <i class="bi bi-award text-4xl text-white"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-white tracking-wide">@Model.Name</h2>
                </div>
            </div>

            <!-- Body -->
            <div class="p-8">
                <div class="text-center mb-8 py-6 bg-surface/50 rounded-2xl border border-slate-700/50 shadow-inner">
                    <span class="text-6xl font-extrabold text-white">@Model.Price</span>
                    <span class="text-slate-400 font-medium ml-1 text-xl">EGP</span>
                </div>

                <div class="space-y-6">
                    <div class="flex items-center gap-4 p-4 rounded-xl hover:bg-surface/50 transition-colors">
                        <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary-light shadow-inner flex-shrink-0">
                            <i class="bi bi-calendar-check text-2xl"></i>
                        </div>
                        <div>
                            <h6 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Duration</h6>
                            <p class="text-lg font-bold text-white">@Model.DurationDays days</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 p-4 rounded-xl hover:bg-surface/50 transition-colors">
                        <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary-light shadow-inner flex-shrink-0 mt-1">
                            <i class="bi bi-file-text text-2xl"></i>
                        </div>
                        <div>
                            <h6 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Description</h6>
                            <p class="text-slate-300 leading-relaxed">@Model.Description</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 p-4 rounded-xl hover:bg-surface/50 transition-colors">
                        <div class="w-12 h-12 rounded-full @(Model.IsActive ? "bg-green-500/10 text-green-400" : "bg-red-500/10 text-red-400") flex items-center justify-center shadow-inner flex-shrink-0">
                            <i class="bi text-2xl @(Model.IsActive ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                        </div>
                        <div>
                            <h6 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Status</h6>
                            @if (Model.IsActive)
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-500/20 text-green-400 border border-green-500/30 shadow-sm">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-400 mr-2 animate-pulse"></span> Active
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-red-500/20 text-red-400 border border-red-500/30 shadow-sm">
                                    Inactive
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="p-6 border-t border-slate-700/50 bg-surfaceHover/30">
                <a asp-controller="Plan" asp-action="GetAllPlans" class="btn-secondary w-full">
                    <i class="bi bi-arrow-left mr-2"></i> Back to Plans
                </a>
            </div>
        </div>
    </div>
</div>
