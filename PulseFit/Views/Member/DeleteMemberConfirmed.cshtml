@model int
@{
    ViewData["Title"] = "Delete Member";
}

<div class="max-w-md mx-auto mt-12">
    <div class="glass-card overflow-hidden p-0 border-red-500/30 shadow-[0_0_15px_rgba(239,68,68,0.1)]">
        <!-- Header -->
        <div class="h-24 bg-gradient-to-r from-red-500/10 to-surface relative flex items-center justify-center">
            <div class="absolute inset-0 bg-[url('/images/pattern.svg')] opacity-5"></div>
            <div
                class="w-16 h-16 rounded-full bg-red-500/20 flex items-center justify-center text-red-500 relative z-10 border border-red-500/30">
                <i class="bi bi-exclamation-triangle text-3xl"></i>
            </div>
        </div>

        <!-- Body -->
        <div class="p-8 text-center">
            <h2 class="text-2xl font-bold text-white mb-2">Delete Member?</h2>
            <p class="text-textMuted mb-6">Are you sure you want to delete this member?</p>

            <div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 mb-8 text-left">
                <div class="flex items-start gap-3">
                    <i class="bi bi-info-circle-fill text-red-400 mt-0.5"></i>
                    <div>
                        <strong class="block text-red-400 mb-1">Warning!</strong>
                        <span class="text-sm text-red-200/70">This action cannot be undone. All member data will be
                            permanently deleted.</span>
                        </div>
                    </div>
                </div>

                <!-- Form -->
                <form asp-action="DeleteMember" method="post" asp-route-id="@Model">
                    <div class="flex justify-between gap-4">
                        <a asp-controller="Member" asp-action="GetAllMembers"
                           class="btn-secondary flex-1 text-center justify-center">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                        <button type="submit"
                                class="w-full inline-flex justify-center items-center gap-2 px-6 py-3 rounded-lg font-medium transition-all duration-300 bg-red-500 hover:bg-red-600 text-white hover:shadow-[0_0_15px_rgba(239,68,68,0.4)] flex-1">
                            <i class="bi bi-trash3"></i> Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>